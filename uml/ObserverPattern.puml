@startuml
skinparam classAttributeIconSize 0
title 飞机大战观察者模式 UML 类图

interface PropObserver {
  + onBomb(): int
  + onFreeze(): void
}

abstract class PropSubject {
  - observers: List<PropObserver>
  + addObserver(observer: PropObserver): void
  + removeObserver(observer: PropObserver): void
  + notifyObservers(): int
}

class BombPropSubject {
  + notifyObservers(): int
}

class FreezePropSubject {
  + notifyObservers(): int
}

abstract class AbstractEnemy {
  + onBomb(): int
  + onFreeze(): void
  + getScore(): int
}

class MobEnemy
class EliteEnemy
class ElitePlusEnemy
class EliteProEnemy
class BossEnemy
class EnemyBullet {
  + onBomb(): int
  + onFreeze(): void
}

PropSubject <|-- BombPropSubject
PropSubject <|-- FreezePropSubject
PropSubject o-- PropObserver
PropObserver <|.. AbstractEnemy
PropObserver <|.. EnemyBullet
AbstractEnemy <|-- MobEnemy
AbstractEnemy <|-- EliteEnemy
AbstractEnemy <|-- ElitePlusEnemy
AbstractEnemy <|-- EliteProEnemy
AbstractEnemy <|-- BossEnemy
@enduml
